rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Gemeinsamer Bingo-Pool inklusive optionalem Bonus-Pool.
    match /smashBingo/sharedPool {
      allow get: if true;
      allow list, delete: if false;

      allow create: if validPool();
      allow update: if validPool()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['fields', 'bonusFields', 'updatedAt']);

      function validPool() {
        return request.resource.data.keys().hasOnly(['fields', 'bonusFields', 'updatedAt'])
          && request.resource.data.fields is list
          && request.resource.data.fields.size() <= 200
          && (!request.resource.data.keys().hasAny(['bonusFields'])
            || (request.resource.data.bonusFields is list
              && request.resource.data.bonusFields.size() <= 100))
          && request.resource.data.updatedAt is timestamp;
      }
    }

    // Gemeinsame Schafkopf-Räume.
    match /schafkopfRooms/{roomId} {
      function signedIn() {
        return request.auth != null;
      }

      function validRoomCode() {
        return roomId.matches('^[A-Z2-9]{5}$');
      }

      function validRoomDocument() {
        return request.resource.data.keys().hasOnly([
          'schemaVersion',
          'ownerId',
          'state',
          'revision',
          'createdAt',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.state is map
        && request.resource.data.revision is int
        && request.resource.data.revision > 0
        && request.resource.data.ownerId is string
        && request.resource.data.updatedBy == request.auth.uid;
      }

      allow create: if signedIn()
        && validRoomCode()
        && validRoomDocument()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Ein Raum kann nur mit bekanntem Raumcode geöffnet werden.
      // Das Auflisten aller Räume bleibt gesperrt.
      allow get: if signedIn() && validRoomCode();
      allow list: if false;

      allow update: if signedIn()
        && validRoomCode()
        && validRoomDocument()
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.updatedAt == request.time;

      allow delete: if signedIn()
        && request.auth.uid == resource.data.ownerId;
    }

    // Alles andere bleibt gesperrt.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
